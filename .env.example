# Application
APP_ENV=development
APP_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=banking
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Logging
LOG_LEVEL=info                  # debug | info | warn | error
LOG_OUTPUT=stdout               # stdout | cloudwatch

# AWS CloudWatch (required when LOG_OUTPUT=cloudwatch)
AWS_REGION=ap-southeast-1
CLOUDWATCH_LOG_GROUP=/banking-api/app
CLOUDWATCH_LOG_STREAM=          # optional — defaults to <hostname>-<YYYY-MM-DD>
