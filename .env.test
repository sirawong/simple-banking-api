# Application
APP_ENV=test
APP_PORT=8080

# PostgreSQL (test container — port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=banking_test
DB_SSLMODE=disable

# Redis (test container — port 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=test-integration-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h

# testutil direct connection strings
TEST_DB_DSN=postgres://postgres:postgres@localhost:5433/banking_test?sslmode=disable
TEST_REDIS_ADDR=localhost:6380
